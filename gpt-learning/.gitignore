# =============================================================================
# Tiny GPT-2 + RLHF 学习项目  .gitignore
# 根目录：e:/ai-learning/05-llm-fundamentals/gpt-learning/.gitignore
#
# 原则：
#   - 全部源代码、配置、合成数据、文档、画图脚本、figure PNG  → 提交
#   - 大型二进制（checkpoint 权重、Python 缓存、IDE/虚拟环境）  → 排除
#   - checkpoints/ 目录结构保留（.gitkeep），但具体权重文件不提交
#
# 注意：gitignore 中不使用 `!` 白名单（避免撤销忽略规则）。
#       git 默认会尊重 .gitignore，git add -A 不会加被忽略的文件。
# =============================================================================


# -----------------------------------------------------------------------------
# [1] Python 字节码与缓存
# -----------------------------------------------------------------------------
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt


# -----------------------------------------------------------------------------
# [2] 虚拟环境
# -----------------------------------------------------------------------------
venv/
.venv/
env/
.env/
.conda/
.python-version


# -----------------------------------------------------------------------------
# [3] PyTorch 检查点（每个 ~3 MB，4 阶段 × 2 子项目 = ~24 MB）
# -----------------------------------------------------------------------------
*.pt
*.pth
*.bin


# -----------------------------------------------------------------------------
# [4] TensorFlow 检查点（.data-00000-of-00001 才是大头，几 MB ~ 几十 MB）
#     实际文件名形如：ppo.ckpt-1.data-00000-of-00001 / ppo.ckpt-1.index / ppo.ckpt-1.meta
# -----------------------------------------------------------------------------
*.ckpt-*.data-*
*.ckpt-*.index
*.ckpt-*.meta
# 兜底：万一有人不写 -N 后缀
*.ckpt.data-*
*.ckpt.index
*.ckpt.meta
*.h5
*.hdf5
*.pb
*.tflite
*.savedmodel
checkpoints/checkpoint
**/checkpoints/checkpoint
checkpoints/keras_metadata.pb
**/checkpoints/keras_metadata.pb
checkpoints/saved_model/
**/checkpoints/saved_model/


# -----------------------------------------------------------------------------
# [5] 日志与运行产物
# -----------------------------------------------------------------------------
*.log
*.out
*.err
*.pid
*.seed
*.pid.lock
*.bak
nohup.out
logs/


# -----------------------------------------------------------------------------
# [6] NLTK 数据（首次运行会自动下载）
# -----------------------------------------------------------------------------
nltk_data/


# -----------------------------------------------------------------------------
# [7] IDE 与编辑器
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# [8] 临时目录与缓存
# -----------------------------------------------------------------------------
.tmp/
tmp/
*.tmp
.cache/
.pytest_cache/
.coverage
htmlcov/
.tox/


# -----------------------------------------------------------------------------
# [9] 大型数据集（若以后接入真实数据，解除注释并按需调整）
# -----------------------------------------------------------------------------
# data/raw/
# data/pretrain_corpus/
# data/pretrain_cache/
# pretrained_*.pt
